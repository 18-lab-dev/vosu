# Maintainer: shiruviaa <https://github.com/shiruviaa/vosu>
pkgname=vosu-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='Native osu! telemetry daemon with a local dashboard'
arch=('x86_64')
url='https://github.com/shiruviaa/vosu'
license=('MIT' 'Apache-2.0')
depends=('glibc' 'libelf' 'zlib' 'libcap')
makedepends=('imagemagick')
provides=('vosu')
conflicts=('vosu')
options=('!strip')
install=vosu-bin.install
source=("vosu-linux-v${pkgver}.zip::https://github.com/shiruviaa/vosu/releases/download/v${pkgver}/vosu-linux-v${pkgver}.zip"
        "vosu.desktop::https://raw.githubusercontent.com/shiruviaa/vosu/v${pkgver}/packaging/linux/vosu.desktop"
        "vosu.svg::https://raw.githubusercontent.com/shiruviaa/vosu/v${pkgver}/assets/branding/vosu-app-icon.svg"
        "vosu-source.png::https://raw.githubusercontent.com/shiruviaa/vosu/v${pkgver}/assets/branding/vosu-app-icon.png")
sha256sums=('@ZIP_SHA256@' '@DESKTOP_SHA256@' '@SVG_SHA256@' '@PNG_SHA256@')

package() {
    install -Dm755 vosu "$pkgdir/usr/bin/vosu"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/vosu/LICENSE"
    install -Dm644 vosu.desktop "$pkgdir/usr/share/applications/vosu.desktop"
    install -Dm644 vosu.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/vosu.svg"
    convert vosu-source.png -resize 256x256 vosu.png
    install -Dm644 vosu.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/vosu.png"
}
