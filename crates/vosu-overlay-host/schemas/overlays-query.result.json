{
  "type": "object",
  "additionalProperties": false,
  "required": ["origin", "overlays", "next"],
  "properties": {
    "origin": { "type": ["string", "null"], "minLength": 8, "maxLength": 512 },
    "overlays": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/overlay" } },
    "next": { "type": ["string", "null"], "minLength": 1 }
  },
  "$defs": {
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "entry", "version", "settings"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "entry": { "type": "string", "minLength": 3 },
        "version": { "type": ["string", "null"], "minLength": 1 },
        "settings": { "type": ["object", "null"] }
      }
    }
  }
}
