{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vosu.app/schemas/manifest.schema.json",
  "title": "Package manifest TOML-to-JSON data model",
  "$comment": "Offline structural checks only; the SDK remains authoritative for semantic/context/asset validation.",
  "$defs": {
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "pluginId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}(\\.[a-z0-9][a-z0-9-]{0,31}){1,3}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*[\\\\:\\u0000])(?!\\.?\\.?(?:/|$))(?!.*?/\\.?\\.?(?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "https": {
      "type": "string",
      "pattern": "^https://[^/@?#\\s]+(?:[/?#][^\\s]*)?$"
    },
    "homepage": {
      "type": "string",
      "pattern": "^https?://[^/\\s]+(?:/[^\\s]*)?$"
    },
    "resolution": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16384
      },
      "minItems": 2,
      "maxItems": 2
    },
    "runtime": {
      "enum": [
        "process",
        "in-process"
      ]
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^(?:game:[a-z][a-z0-9-]{0,31}|(?:field|action|resource):[a-z0-9][A-Za-z0-9-]*(?:\\.[a-z0-9][A-Za-z0-9-]*)*)$"
    },
    "lane": {
      "type": "object",
      "properties": {
        "pointer": {
          "type": "string",
          "pattern": "^(?:/(?:[^~]|~[01])*)*$"
        },
        "lane": {
          "enum": [
            "regular",
            "precise",
            "both"
          ]
        },
        "activity": {
          "enum": [
            "always",
            "gameplay"
          ]
        }
      },
      "required": [
        "pointer",
        "lane",
        "activity"
      ],
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/capabilityId"
        },
        "version": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "provide": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/capabilityId"
        },
        "version": {
          "$ref": "#/$defs/text"
        },
        "schema": {
          "$ref": "#/$defs/path"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "catalogProvide": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/capabilityId"
        },
        "version": {
          "$ref": "#/$defs/text"
        },
        "schema_version": {
          "$ref": "#/$defs/version"
        },
        "lanes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lane"
          },
          "default": []
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}(\\.[a-z0-9][a-z0-9-]{0,31})*$"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "args_schema": {
          "$ref": "#/$defs/path"
        },
        "result_schema": {
          "$ref": "#/$defs/path"
        },
        "session": {
          "enum": [
            "required",
            "optional",
            "none"
          ]
        },
        "cli": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "name",
        "version",
        "title",
        "args_schema",
        "result_schema",
        "session"
      ],
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/id"
        },
        "tree": {
          "type": "boolean",
          "default": false
        },
        "families": {
          "type": "array",
          "items": {
            "enum": [
              "image",
              "audio",
              "video",
              "chart-text"
            ]
          },
          "default": []
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "matcher": {
      "type": "object",
      "properties": {
        "process_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "process_path_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "command_line_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "comm_hints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 15,
            "pattern": "^[^\\u0000]+$"
          },
          "default": []
        },
        "linux_name_contains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 15,
            "pattern": "^[^\\u0000]+$"
          },
          "default": []
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "package": {
      "type": "object",
      "properties": {
        "url": {
          "$ref": "#/$defs/https"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "url",
        "sha256",
        "size"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/pluginId"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "host": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "homepage": {
          "$ref": "#/$defs/homepage"
        },
        "replaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pluginId"
          },
          "default": [],
          "uniqueItems": true
        },
        "provides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provide"
          },
          "default": []
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          },
          "default": []
        },
        "optional": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          },
          "default": []
        },
        "manifest_version": {
          "const": 1
        },
        "kind": {
          "const": "plugin"
        },
        "icon": {
          "$ref": "#/$defs/path"
        },
        "banner": {
          "$ref": "#/$defs/path"
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          },
          "default": []
        },
        "resource_kinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          },
          "default": []
        },
        "covers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^field:vosu\\.(?:client|status|chart|play|skin)(?:\\.[A-Za-z0-9-]+)*$"
          },
          "default": [],
          "uniqueItems": true
        },
        "abi_version": {
          "const": 1
        },
        "concurrent_dispatch": {
          "type": "boolean",
          "default": false
        },
        "settings_schema": {
          "$ref": "#/$defs/path"
        },
        "root_slots": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "default": [],
          "uniqueItems": true
        },
        "targets": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9_]+(?:-[a-z0-9_]+){2,}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "library": {
                "$ref": "#/$defs/path"
              }
            },
            "required": [
              "library"
            ],
            "additionalProperties": false
          },
          "default": {}
        },
        "match": {
          "$ref": "#/$defs/matcher"
        }
      },
      "required": [
        "manifest_version",
        "kind",
        "id",
        "name",
        "version",
        "host",
        "abi_version",
        "runtime"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "host": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "homepage": {
          "$ref": "#/$defs/homepage"
        },
        "replaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "default": [],
          "uniqueItems": true
        },
        "provides": {
          "type": "array",
          "maxItems": 0,
          "default": []
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          },
          "default": []
        },
        "optional": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          },
          "default": []
        },
        "manifest_version": {
          "const": 1
        },
        "kind": {
          "const": "tool"
        },
        "icon": {
          "$ref": "#/$defs/path"
        },
        "banner": {
          "$ref": "#/$defs/path"
        },
        "ui": {
          "type": "object",
          "properties": {
            "root": {
              "$ref": "#/$defs/path"
            },
            "entry": {
              "$ref": "#/$defs/path",
              "default": "index.html"
            }
          },
          "required": [
            "root"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "manifest_version",
        "kind",
        "id",
        "name",
        "version",
        "host",
        "ui"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "host": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "homepage": {
          "$ref": "#/$defs/homepage"
        },
        "replaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "default": [],
          "uniqueItems": true
        },
        "provides": {
          "type": "array",
          "maxItems": 0,
          "default": []
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          },
          "default": []
        },
        "optional": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          },
          "default": []
        },
        "manifest_version": {
          "const": 1
        },
        "kind": {
          "const": "overlay"
        },
        "icon": {
          "$ref": "#/$defs/path"
        },
        "banner": {
          "$ref": "#/$defs/path"
        },
        "resolution": {
          "$ref": "#/$defs/resolution"
        }
      },
      "required": [
        "manifest_version",
        "kind",
        "id",
        "name",
        "version",
        "host"
      ],
      "additionalProperties": false
    }
  ]
}
