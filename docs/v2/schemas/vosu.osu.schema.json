{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vosu.dev/schemas/v2/vosu.osu.schema.json",
  "version": "1.2.0",
  "title": "vosu.osu",
  "description": "The official osu! plugin's namespace (ADR 0020): every osu!-specific datum 1.x exposed, restructured for clarity. See docs/v2/state-schema.md for the full 1.x-to-2.0 field mapping and the common-layer coverage this plugin declares.",
  "type": "object",
  "required": ["session","profile","beatmap","play","keys","leaderboard","performance","result","settings","skin","rankedPlay","room","tourney"],
  "additionalProperties": false,
  "$defs": {
    "numberName": {
      "type": "object",
      "required": ["number","name"],
      "additionalProperties": false,
      "properties": {"number":{"type":["integer","null"]},"name":{"type":"string"}}
    },
    "difficultyPair": {
      "type": "object",
      "required": ["original","converted"],
      "additionalProperties": false,
      "properties": {"original":{"type":"number"},"converted":{"type":"number"}},
      "description": "Raw difficulty value and the value after ruleset conversion/mod application."
    },
    "hitErrorTriplet": {
      "type": "object",
      "required": ["all","press","release"],
      "additionalProperties": false,
      "description": "The original upstream-compatible timing-error array plus vosu's press/release split (README: each original value appears exactly once, in order, in press or release).",
      "properties": {
        "all": {"type":"array","items":{"type":"number"}},
        "press": {"type":"array","items":{"type":"number"}},
        "release": {"type":"array","items":{"type":"number"}}
      }
    },
    "keyHitErrors": {
      "type": "object",
      "required": ["press","release"],
      "additionalProperties": false,
      "description": "Per-lane split of hitErrors, zero-based displayed mania lane. Only matched events are classified (see state-schema.md for exclusions).",
      "properties": {
        "press": {"type":"array","items":{"type":"array","items":{"type":"number"}}},
        "release": {"type":"array","items":{"type":"array","items":{"type":"number"}}}
      }
    },
    "keypress": {
      "type": "object",
      "required": ["name","isPressed","count","pressedAt","releasedAt"],
      "additionalProperties": false,
      "properties": {
        "name": {"type":"string","description":"Logical action name, e.g. `B1`; not a physical key name."},
        "isPressed": {"type":"boolean"},
        "count": {"type":"integer","minimum":0},
        "pressedAt": {"type":["number","null"],"description":"Gameplay milliseconds of the most recent down edge."},
        "releasedAt": {"type":["number","null"]}
      }
    },
    "mod": {"type":"object","required":["acronym"],"additionalProperties":false,"properties":{"acronym":{"type":"string"},"settings":{"type":"object"}}},
    "mods": {
      "type": "object",
      "required": ["checksum","number","name","array","rate"],
      "additionalProperties": false,
      "properties": {
        "checksum": {"type":"string"},
        "number": {"type":"integer","description":"Legacy mod bitflags."},
        "name": {"type":"string","description":"Combined mod acronym string, e.g. `HDHR`."},
        "array": {"type":"array","items":{"$ref":"#/$defs/mod"}},
        "rate": {"type":"number","exclusiveMinimum":0}
      }
    },
    "statistics": {
      "type": "object",
      "description": "osu!-specific hit-outcome counts not expressed by the common `vosu.play.judgements` breakdown: slider/hold ticks and bonuses, combo breaks, and legacy-scoring bookkeeping (1.x `Statistics`/`Hits`/`LazerHits`).",
      "required": ["smallTickMiss","smallTickHit","largeTickMiss","largeTickHit","smallBonus","largeBonus","ignoreMiss","ignoreHit","comboBreak","sliderTailHit","sliderBreaks","sliderEndHits","legacyComboIncrease","good"],
      "additionalProperties": false,
      "properties": {
        "smallTickMiss": {"type":"integer","minimum":0},
        "smallTickHit": {"type":"integer","minimum":0},
        "largeTickMiss": {"type":"integer","minimum":0},
        "largeTickHit": {"type":"integer","minimum":0},
        "smallBonus": {"type":"integer","minimum":0},
        "largeBonus": {"type":"integer","minimum":0},
        "ignoreMiss": {"type":"integer","minimum":0},
        "ignoreHit": {"type":"integer","minimum":0},
        "comboBreak": {"type":"integer","minimum":0},
        "sliderTailHit": {"type":"integer","minimum":0},
        "sliderBreaks": {"type":"integer","minimum":0},
        "sliderEndHits": {"type":"integer","minimum":0},
        "good": {"type":"integer","minimum":0,"description":"1.x katu (1.2.0, additive)."},
        "legacyComboIncrease": {"type":["integer","null"]}
      }
    },
    "combo": {
      "type": "object",
      "required": ["current","max"],
      "additionalProperties": false,
      "properties": {"current":{"type":"integer","minimum":0},"max":{"type":"integer","minimum":0}}
    },
    "hitWindow": {
      "type": "object",
      "additionalProperties": false,
      "description": "Maximum absolute timing error in ms per judgement, after the active clock rate; unsupported judgements omitted. Catch publishes all six as zero.",
      "properties": {
        "miss": {"type":"number"},
        "meh": {"type":"number"},
        "ok": {"type":"number"},
        "good": {"type":"number"},
        "great": {"type":"number"},
        "perfect": {"type":"number"}
      }
    },
    "stats": {
      "type": "object",
      "required": ["stars","ar","cs","od","hp","bpm","objects","hitWindow","maxCombo"],
      "additionalProperties": false,
      "properties": {
        "stars": {
          "type": "object",
          "required": ["live","total"],
          "additionalProperties": false,
          "properties": {
            "live": {"type":"number","x-sampling-lane":{"lane":"regular","activity":"gameplay"}},
            "aim": {"type":"number"},
            "speed": {"type":"number"},
            "flashlight": {"type":"number"},
            "sliderFactor": {"type":"number"},
            "stamina": {"type":"number"},
            "rhythm": {"type":"number"},
            "color": {"type":"number"},
            "reading": {"type":"number"},
            "hitWindow": {"type":"number"},
            "total": {"type":"number"}
          }
        },
        "ar": {"$ref":"#/$defs/difficultyPair"},
        "cs": {"$ref":"#/$defs/difficultyPair"},
        "od": {"$ref":"#/$defs/difficultyPair"},
        "hp": {"$ref":"#/$defs/difficultyPair"},
        "bpm": {
          "type": "object",
          "required": ["realtime","common","min","max"],
          "additionalProperties": false,
          "properties": {"realtime":{"type":"number"},"common":{"type":"number"},"min":{"type":"number"},"max":{"type":"number"}}
        },
        "objects": {
          "type": "object",
          "required": ["circles","sliders","spinners","holds","total"],
          "additionalProperties": false,
          "properties": {
            "circles": {"type":"integer","minimum":0},
            "sliders": {"type":"integer","minimum":0},
            "spinners": {"type":"integer","minimum":0},
            "holds": {"type":"integer","minimum":0},
            "total": {"type":"integer","minimum":0}
          }
        },
        "hitWindow": {"$ref":"#/$defs/hitWindow"},
        "maxCombo": {"type":"integer","minimum":0}
      }
    },
    "ppAttributes": {
      "type": "object",
      "required": ["aim","speed","accuracy","difficulty","flashlight","total"],
      "additionalProperties": false,
      "properties": {
        "aim": {"type":"number"},
        "speed": {"type":"number"},
        "accuracy": {"type":"number"},
        "difficulty": {"type":"number"},
        "flashlight": {"type":"number"},
        "total": {"type":"number"}
      }
    },
    "sides": {
      "type": "object",
      "required": ["left","right"],
      "additionalProperties": false,
      "description": "One value per tourney team side.",
      "properties": {"left":{},"right":{}}
    },
    "tourneyClientPlay": {
      "type": "object",
      "description": "One tourney client's play snapshot: the same shape as the top-level `play` namespace member's osu!-specific fields.",
      "required": ["source","failed","playerName","mode","healthBar","statistics","hitErrors","mods","rank","pp","unstableRate"],
      "additionalProperties": false,
      "properties": {
        "source": {"enum":["player","replay","spectator","watching","autoplay",null]},
        "failed": {"type":"boolean"},
        "playerName": {"type":"string"},
        "mode": {"$ref":"#/$defs/numberName"},
        "healthBar": {
          "type": "object",
          "required": ["normal","smooth"],
          "additionalProperties": false,
          "properties": {"normal":{"type":"number"},"smooth":{"type":"number"}}
        },
        "statistics": {"$ref":"#/$defs/statistics"},
        "hitErrors": {"$ref":"#/$defs/hitErrorTriplet"},
        "mods": {"$ref":"#/$defs/mods"},
        "rank": {
          "type": "object",
          "required": ["current","maxThisPlay"],
          "additionalProperties": false,
          "properties": {"current":{"type":"string"},"maxThisPlay":{"type":"string"}}
        },
        "pp": {
          "type": "object",
          "required": ["current","fc","maxAchieved","maxAchievable","detailed"],
          "additionalProperties": false,
          "properties": {
            "current": {"type":"number"},
            "fc": {"type":"number"},
            "maxAchieved": {"type":"number"},
            "maxAchievable": {"type":"number"},
            "detailed": {
              "type": "object",
              "required": ["current","fc"],
              "additionalProperties": false,
              "properties": {"current":{"$ref":"#/$defs/ppAttributes"},"fc":{"$ref":"#/$defs/ppAttributes"}}
            }
          }
        },
        "unstableRate": {"type":"number","minimum":0},
        "score": {"type":"number","minimum":0,"description":"1.2.0, additive: matches the lazer spectator client's `play.score` (R6)."},
        "accuracy": {"type":"number","description":"1.2.0, additive: matches the lazer spectator client's `play.accuracy` (R6, 0-100 as 1.x reports it)."},
        "combo": {"$ref":"#/$defs/combo","description":"1.2.0, additive: matches the lazer spectator client's `play.combo` (R6)."},
        "judgements": {
          "type": "object",
          "description": "1.2.0, additive (R6): this client's own judgement breakdown, the same counts shape as `result.statistics`.",
          "required": ["miss","meh","ok","great","perfect"],
          "additionalProperties": false,
          "properties": {
            "miss": {"type":"integer","minimum":0},
            "meh": {"type":"integer","minimum":0},
            "ok": {"type":"integer","minimum":0},
            "great": {"type":"integer","minimum":0},
            "perfect": {"type":"integer","minimum":0},
            "good": {"type":"integer","minimum":0}
          }
        }
      }
    }
  },
  "properties": {
    "session": {
      "type": "object",
      "required": ["playTime","playCount","paused","focused"],
      "additionalProperties": false,
      "description": "osu!-specific session bookkeeping not covered by vosu.client.",
      "properties": {
        "playTime": {"type":"number","x-sampling-lane":{"lane":"regular","activity":"always"}},
        "playCount": {"type":"integer","minimum":0},
        "paused": {"type":"boolean","x-sampling-lane":{"lane":"regular","activity":"gameplay"}},
        "focused": {"type":["boolean","null"],"description":"Windows-only: whether the client window has OS input focus. `null` elsewhere."},
        "ipcId": {
          "type": ["number","null"],
          "description": "D6, optional (1.1.0 bump, additive alongside `internal`): the tournament spectator client's IPC id, as 1.x stores it (`Option<f64>`); `null` or absent for every non-spectator session. A spectator session is identified as a normal session, never hidden for being one."
        },
        "state": {
          "$ref": "#/$defs/numberName",
          "description": "1.2.0, additive (MA, R1): the verbatim 1.x `GameState` `{number,name}` pair this session is in, kept beside the coarse `vosu.status.status` for osu!-specific consumers (results/edit/select variants the common enum collapses).",
          "x-sampling-lane": {"lane":"precise","activity":"always"}
        },
        "server": {"type":["string","null"],"description":"1.2.0, additive (R7): 1.x `server`, the bancho host string; `null` when unknown."}
      }
    },
    "profile": {
      "type": "object",
      "required": ["userStatus","banchoStatus","id","name","mode","rankedScore","level","accuracy","pp","playCount","globalRank","countryCode","backgroundColour","matchmaking"],
      "additionalProperties": false,
      "properties": {
        "userStatus": {"$ref":"#/$defs/numberName"},
        "banchoStatus": {"$ref":"#/$defs/numberName"},
        "id": {"type":["integer","null"]},
        "name": {"type":["string","null"]},
        "mode": {"$ref":"#/$defs/numberName"},
        "rankedScore": {"type":["number","null"],"minimum":0},
        "level": {"type":["number","null"]},
        "accuracy": {"type":["number","null"]},
        "pp": {"type":["number","null"]},
        "playCount": {"type":["integer","null"],"minimum":0},
        "globalRank": {"type":["integer","null"]},
        "countryCode": {"$ref":"#/$defs/numberName"},
        "backgroundColour": {"type":["string","null"]},
        "matchmaking": {
          "oneOf": [
            {
              "type": "object",
              "required": ["rating","rank","plays","wins","isProvisional"],
              "additionalProperties": false,
              "properties": {
                "rating": {"type":"number"},
                "rank": {"type":["integer","null"]},
                "plays": {"type":"integer","minimum":0},
                "wins": {"type":"integer","minimum":0},
                "isProvisional": {"type":"boolean"}
              }
            },
            {"type":"null"}
          ]
        }
      }
    },
    "beatmap": {
      "type": "object",
      "required": ["isKiai","isBreak","isConvert","time","status","checksum","id","set","mode","artist","artistUnicode","title","titleUnicode","mapper","version","source","tags","stats"],
      "additionalProperties": false,
      "description": "Full osu! beatmap detail. `title`/`artist`/`version`/`mapper`/time.length/stats.bpm.common/stats.objects` keyCount feed the vosu.chart projection; see state-schema.md's mapping table.",
      "properties": {
        "isKiai": {"type":"boolean","x-sampling-lane":{"lane":"regular","activity":"gameplay"}},
        "isBreak": {"type":"boolean","x-sampling-lane":{"lane":"regular","activity":"gameplay"}},
        "isConvert": {"type":"boolean"},
        "time": {
          "type": "object",
          "required": ["live","rate","running","firstObject","lastObject","mp3Length"],
          "additionalProperties": false,
          "properties": {
            "live": {"type":"number","x-sampling-lane":{"lane":"precise","activity":"always"}},
            "rate": {"type":["number","null"],"x-sampling-lane":{"lane":"regular","activity":"gameplay"}},
            "running": {"type":["boolean","null"],"x-sampling-lane":{"lane":"regular","activity":"gameplay"}},
            "firstObject": {"type":"integer"},
            "lastObject": {"type":"number"},
            "mp3Length": {"type":["number","null"]}
          }
        },
        "status": {"$ref":"#/$defs/numberName"},
        "checksum": {"type":["string","null"]},
        "id": {"type":["integer","null"]},
        "set": {"type":["integer","null"]},
        "mode": {"$ref":"#/$defs/numberName"},
        "artist": {"type":["string","null"]},
        "artistUnicode": {"type":["string","null"]},
        "title": {"type":["string","null"]},
        "titleUnicode": {"type":["string","null"]},
        "mapper": {"type":["string","null"]},
        "version": {"type":["string","null"]},
        "source": {"type":"string"},
        "tags": {"type":"string"},
        "stats": {"$ref":"#/$defs/stats"}
      }
    },
    "play": {
      "type": "object",
      "required": ["source","failed","playerName","mode","healthBar","statistics","hitErrors","hitOffsets","keyHitErrors","catcher","mods","rank","pp","unstableRate"],
      "additionalProperties": false,
      "description": "osu!-specific play detail layered beside the common vosu.play fields this plugin also fills (score, combo, maxCombo, accuracy, health, progress, rate, judgements).",
      "properties": {
        "source": {"enum":["player","replay","spectator","watching","autoplay",null],"x-sampling-lane":{"lane":"regular","activity":"gameplay"}},
        "failed": {"type":"boolean","x-sampling-lane":{"lane":"regular","activity":"gameplay"}},
        "playerName": {"type":"string","x-sampling-lane":{"lane":"regular","activity":"gameplay"}},
        "mode": {"$ref":"#/$defs/numberName","x-sampling-lane":{"lane":"regular","activity":"gameplay"}},
        "healthBar": {
          "type": "object",
          "required": ["normal","smooth"],
          "additionalProperties": false,
          "properties": {"normal":{"type":"number"},"smooth":{"type":"number"}},
          "x-sampling-lane": {"lane":"regular","activity":"gameplay"}
        },
        "statistics": {"$ref":"#/$defs/statistics","x-sampling-lane":{"lane":"regular","activity":"gameplay"}},
        "hitErrors": {"$ref":"#/$defs/hitErrorTriplet","x-sampling-lane":{"lane":"precise","activity":"gameplay"}},
        "hitOffsets": {
          "type": ["array","null"],
          "items": {"type":"number"},
          "description": "Flat stride-3 `[x, y, error, ...]`, osu!standard circle/slider-head hits only. Subscribing opts in; there is no separate enable flag in 2.0.",
          "x-sampling-lane": {"lane":"precise","activity":"gameplay"}
        },
        "keyHitErrors": {"oneOf":[{"$ref":"#/$defs/keyHitErrors"},{"type":"null"}],"x-sampling-lane":{"lane":"precise","activity":"gameplay"}},
        "catcher": {
          "oneOf": [
            {
              "type": "object",
              "required": ["x","dashing"],
              "additionalProperties": false,
              "properties": {
                "x": {"type":"number","minimum":0,"maximum":512,"description":"Stored playfield position in osu! pixels, not screen-space."},
                "dashing": {"type":"boolean"}
              }
            },
            {"type":"null"}
          ],
          "description": "Catch only; omitted (null) in menus, results, and other rulesets.",
          "x-sampling-lane": {"lane":"precise","activity":"gameplay"}
        },
        "mods": {"$ref":"#/$defs/mods","x-sampling-lane":{"lane":"regular","activity":"gameplay"}},
        "rank": {
          "type": "object",
          "required": ["current","maxThisPlay"],
          "additionalProperties": false,
          "properties": {"current":{"type":"string"},"maxThisPlay":{"type":"string"}},
          "x-sampling-lane": {"lane":"regular","activity":"gameplay"}
        },
        "pp": {
          "type": "object",
          "required": ["current","fc","maxAchieved","maxAchievable","detailed"],
          "additionalProperties": false,
          "properties": {
            "current": {"type":"number"},
            "fc": {"type":"number"},
            "maxAchieved": {"type":"number"},
            "maxAchievable": {"type":"number"},
            "detailed": {
              "type": "object",
              "required": ["current","fc"],
              "additionalProperties": false,
              "properties": {"current":{"$ref":"#/$defs/ppAttributes"},"fc":{"$ref":"#/$defs/ppAttributes"}}
            }
          },
          "x-sampling-lane": {"lane":"regular","activity":"gameplay"}
        },
        "unstableRate": {"type":"number","minimum":0,"x-sampling-lane":{"lane":"both","activity":"gameplay"}}
      }
    },
    "keys": {
      "type": "object",
      "required": ["all"],
      "additionalProperties": false,
      "description": "Mode-free key/button state. `all` is the canonical logical-action list; see state-schema.md for the per-ruleset `B1..BN` mapping table.",
      "x-sampling-lane": {"lane":"precise","activity":"gameplay"},
      "properties": {"all":{"type":"array","items":{"$ref":"#/$defs/keypress"}}}
    },
    "leaderboard": {
      "type": "array",
      "x-sampling-lane": {"lane":"regular","activity":"gameplay"},
      "items": {
        "type": "object",
        "required": ["isFailed","position","team","id","name","score","accuracy","statistics","combo","mods","rank"],
        "additionalProperties": false,
        "properties": {
          "isFailed": {"type":"boolean"},
          "position": {"type":"integer"},
          "team": {"type":"integer"},
          "id": {"type":"integer"},
          "name": {"type":"string"},
          "score": {"type":"number","minimum":0},
          "accuracy": {"type":"number"},
          "statistics": {
            "type": "object",
            "required": ["miss","meh","ok","great","perfect"],
            "additionalProperties": false,
            "description": "This entry's own judgement breakdown; shaped like vosu.play.judgements counts rather than the full common list, since a leaderboard entry is not the subscribed session.",
            "properties": {
              "miss": {"type":"integer","minimum":0},
              "meh": {"type":"integer","minimum":0},
              "ok": {"type":"integer","minimum":0},
              "great": {"type":"integer","minimum":0},
              "perfect": {"type":"integer","minimum":0},
              "good": {"type":"integer","minimum":0,"description":"1.x `katu` (1.2.0, additive)."}
            }
          },
          "combo": {"$ref":"#/$defs/combo"},
          "mods": {"$ref":"#/$defs/mods"},
          "rank": {"type":"string"}
        }
      }
    },
    "performance": {
      "type": "object",
      "required": ["accuracy","graph"],
      "additionalProperties": false,
      "description": "The legacy calculation facade's pp-by-accuracy table and difficulty-over-time graph.",
      "properties": {
        "accuracy": {
          "type": "object",
          "description": "pp at fixed accuracy percentiles 90-100, keyed by percentile.",
          "required": ["90","91","92","93","94","95","96","97","98","99","100"],
          "additionalProperties": false,
          "properties": {
            "90": {"type":"number"},
            "91": {"type":"number"},
            "92": {"type":"number"},
            "93": {"type":"number"},
            "94": {"type":"number"},
            "95": {"type":"number"},
            "96": {"type":"number"},
            "97": {"type":"number"},
            "98": {"type":"number"},
            "99": {"type":"number"},
            "100": {"type":"number"}
          },
          "x-sampling-lane": {"lane":"regular","activity":"gameplay"}
        },
        "graph": {
          "type": "object",
          "required": ["series","xaxis"],
          "additionalProperties": false,
          "properties": {
            "series": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name","data"],
                "additionalProperties": false,
                "properties": {"name":{"type":"string"},"data":{"type":"array","items":{"type":"number"}}}
              }
            },
            "xaxis": {"type":"array","items":{"type":"number"}}
          }
        }
      }
    },
    "result": {
      "type": "object",
      "required": ["scoreId","playerName","mode","score","accuracy","name","statistics","mods","maxCombo","rank","pp","createdAt"],
      "additionalProperties": false,
      "description": "The results-screen snapshot of the just-finished attempt (1.x `resultsScreen`). Distinct from `vosu.status.status == \"results\"`, which only marks the coarse status.",
      "properties": {
        "scoreId": {"type":"number"},
        "playerName": {"type":"string"},
        "mode": {"$ref":"#/$defs/numberName"},
        "score": {"type":"number","minimum":0},
        "accuracy": {"type":"number"},
        "name": {"type":"string","description":"Score display label, in the client's own results-screen terms."},
        "statistics": {
          "type": "object",
          "required": ["miss","meh","ok","great","perfect","sliderEndHits","smallTickHits","largeTickHits","sliderBreaks"],
          "additionalProperties": false,
          "properties": {
            "miss": {"type":"integer","minimum":0},
            "meh": {"type":"integer","minimum":0},
            "ok": {"type":"integer","minimum":0},
            "great": {"type":"integer","minimum":0},
            "perfect": {"type":"integer","minimum":0},
            "sliderEndHits": {"type":"integer","minimum":0},
            "smallTickHits": {"type":"integer","minimum":0},
            "largeTickHits": {"type":"integer","minimum":0},
            "sliderBreaks": {"type":"integer","const":0,"description":"Known limitation: always 0, matching the 1.x v1 precedent at src/api/v1.rs:692 (A2b)."},
            "good": {"type":"integer","minimum":0,"description":"1.x `katu` (1.2.0, additive)."}
          }
        },
        "mods": {"$ref":"#/$defs/mods"},
        "maxCombo": {"type":"integer","minimum":0},
        "rank": {"type":"string"},
        "pp": {"type":"object","required":["current","fc"],"additionalProperties":false,"properties":{"current":{"type":"number"},"fc":{"type":"number"}}},
        "createdAt": {"type":"string","format":"date-time"}
      }
    },
    "settings": {
      "type": "object",
      "description": "osu!-specific client settings. `interfaceVisible`/`replayUIVisible`/`bassDensity` feed demand-driven sampling as in 1.x.",
      "required": ["interfaceVisible","replayUIVisible","chatVisibilityStatus","leaderboard","progressBar","bassDensity","resolution","client","scoreMeter","cursor","mouse","tablet","mania","sort","group","mode","audio","background","keybinds","visual"],
      "additionalProperties": false,
      "properties": {
        "interfaceVisible": {"type":"boolean","x-sampling-lane":{"lane":"regular","activity":"gameplay"}},
        "replayUIVisible": {"type":"boolean","x-sampling-lane":{"lane":"regular","activity":"gameplay"}},
        "chatVisibilityStatus": {"$ref":"#/$defs/numberName"},
        "leaderboard": {
          "type": "object",
          "required": ["visible","type"],
          "additionalProperties": false,
          "properties": {"visible":{"type":"boolean"},"type":{"$ref":"#/$defs/numberName"}}
        },
        "progressBar": {"$ref":"#/$defs/numberName"},
        "bassDensity": {"type":"number","x-sampling-lane":{"lane":"regular","activity":"always"}},
        "resolution": {
          "type": "object",
          "required": ["fullscreen","width","height","widthFullscreen","heightFullscreen"],
          "additionalProperties": false,
          "properties": {
            "fullscreen": {"type":"boolean"},
            "width": {"type":"integer"},
            "height": {"type":"integer"},
