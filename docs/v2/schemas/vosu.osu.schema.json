                {
                  "type": "object",
                  "required": ["data","files"],
                  "additionalProperties": false,
                  "properties": {"data":{"type":["string","null"]},"files":{"type":["string","null"]}}
                },
                {"type":"null"}
              ]
            },
            "current": {
              "description": "1.2.0, additive (R8, M4a-blocking): the current chart's folder/file names only, never a joined path (ADR 0021); `null` entirely when no chart is selected; `background`/`audio` are independently `null` when the chart has none. Home for the 1.x `folders.beatmap`/`files.*` sources M4a's upstream adapter must echo byte-identically.",
              "oneOf": [
                {
                  "type": "object",
                  "required": ["beatmapFolder","beatmapFile","background","audio"],
